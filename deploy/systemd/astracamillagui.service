[Unit]
Description=AstraCamillaGui - CamillaDSP Graphical Equalizer Interface
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=astracamillagui
Group=astracamillagui
WorkingDirectory=/opt/astracamillagui
EnvironmentFile=/etc/astracamillagui/astracamillagui.env
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astracamillagui

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astracamillagui/data

[Install]
WantedBy=multi-user.target
