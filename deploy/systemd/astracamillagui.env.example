# AstraCamillaGui Environment Configuration
# Copy this file to /etc/astracamillagui/astracamillagui.env and customize as needed

# Server Configuration
NODE_ENV=production
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Data Storage (relative to WorkingDirectory in service file)
CONFIG_DIR=./data

# Logging (levels: error, warn, info, debug)
LOG_LEVEL=info

# Build Metadata (injected during CI/CD)
# BUILD_HASH=abc123
# BUILD_TIME=2026-02-04T00:00:00.000Z

# CamillaDSP Connection Defaults (optional - used as GUI defaults when no localStorage)
CAMILLA_CONTROL_WS_URL=ws://astracamillagui.his.house:3146
CAMILLA_SPECTRUM_WS_URL=ws://astracamillagui.his.house:6413

# File CamillaDSP loads on startup. The Save button writes the running config here.
# On moOde: /usr/share/camilladsp/configs/custom (working_config.yml links to it).
# Unset disables saving.
# DSP_CONFIG_FILE=/usr/share/camilladsp/configs/custom

# Read-Only Mode
# When true, server refuses any write operations (PUT/POST/PATCH/DELETE to /api/*).
# CamillaDSP control from browser remains fully functional.
# Use this when AstraCamillaGui is publicly exposed but should not accept persistence changes.
SERVER_READ_ONLY=false
